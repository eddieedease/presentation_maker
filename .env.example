# ---- Database (MySQL container) ----
DB_NAME=presmaker
DB_USER=presmaker
DB_PASSWORD=presmaker
DB_ROOT_PASSWORD=rootsecret
DB_PORT=3307

# ---- Ports on the host ----
API_PORT=8080
PMA_PORT=8081

# ---- API ----
# Generate a new one with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ISSUER=presmaker-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
APP_FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- OAuth 2.0 (optional: email/password sign-in works without these) ----
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/oauth/github/callback
